# ──────────────────────────────────────────────────────────────────────
# BindingSolution configuration
#
# Copy this file to `.env` (scripts/setup.sh does it for you) and fill
# in your keys. `.env` is gitignored and never leaves your machine.
# Full documentation: docs/CONFIGURATION.md
# ──────────────────────────────────────────────────────────────────────

# ── Claude API (powers categorization, connections, strategies, spec
#    analysis). Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for analysis. Default: claude-opus-4-8
#ANTHROPIC_MODEL=claude-opus-4-8

# ── Zotero — option A: Web API (works anywhere) ───────────────────────
# Your numeric userID: https://www.zotero.org/settings/keys
#   ("Your userID for use in API calls")
ZOTERO_LIBRARY_ID=
# A read-only key: https://www.zotero.org/settings/keys/new
ZOTERO_API_KEY=
# "user" for personal libraries, "group" for a group library
# (for groups, ZOTERO_LIBRARY_ID is the group ID from the group's URL)
ZOTERO_LIBRARY_TYPE=user

# ── Zotero — option B: local Zotero app (no API key needed) ───────────
# Requires Zotero 7 running on this machine with the local API enabled:
# Zotero → Settings → Advanced → "Allow other applications on this
# computer to communicate with Zotero". Then set:
#ZOTERO_LOCAL=true
#ZOTERO_LIBRARY_ID=0

# ── Server ────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Extras ────────────────────────────────────────────────────────────
# Where synced data is stored (gitignored). Default: ./data
#BINDING_DATA_DIR=./data
# Return canned AI responses instead of calling the API (UI demos/tests)
#MOCK_LLM=true
# By default the server opens your browser on start. Set this to disable it
# (e.g. on a headless/remote machine).
#BINDING_NO_BROWSER=true
