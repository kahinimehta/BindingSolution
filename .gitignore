# ── Secrets ───────────────────────────────────────────────────────────
# .env holds API keys and must NEVER be committed. .env.example is the
# tracked, key-free template.
.env
.env.*
!.env.example

# ── Local data (synced library, specs, analyses) ─────────────────────
data/

# ── Python ────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Vercel (local CLI link metadata; app is localhost-only) ───────────
.vercel/

# ── OS / editor noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
